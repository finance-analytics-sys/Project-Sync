# Server
PORT=3000

# JWT secret — generate a strong random string for production
JWT_SECRET=change-this-to-a-random-secret

# Google OAuth (from Google Cloud Console → project-sync-514413)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Gmail SMTP for PTO notifications
GMAIL_USER=visitingangels.ptorequest@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# Geofence radius in meters (default: 200)
GEOFENCE_RADIUS_METERS=200

# Base URL for email links (set to your Render URL)
BASE_URL=https://your-app.onrender.com

# Data directory — for Render persistent disk, set to /data
# Leave blank to use default (server/data/)
DATA_DIR=
